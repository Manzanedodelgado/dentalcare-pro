# 🌐 RENDER.COM POSTGRESQL - app.rubiogarciadental
# Service ID: srv-d4a2687gi27c739q5i4g
# API Key: rnd_wv4YtHGe1Apd5bKMtzQ9kYggKKDQ
# 
# 📋 VER configure-render.js para obtener credenciales
# 📖 VER RENDER_CONFIGURATION.md para guía completa
# NUNCA subas este archivo con credenciales reales a Git

# ==============================================
# RENDER.COM POSTGRESQL (PRIMARY DATABASE)
# ==============================================
# 🔧 INSTRUCCIONES: Ejecutar node configure-render.js
# 🌐 Obtener credenciales desde: https://dashboard.render.com
# 👤 Servicio: app.rubiogarciadental
DB_HOST=TU_HOST_RENDER_POSTGRESQL
DB_PORT=5432
DB_NAME=postgres  # Por defecto en Render
DB_USER=postgres  # Por defecto en Render  
DB_PASSWORD=TU_PASSWORD_RENDER_POSTGRESQL
DB_SSL=true       # Render requiere SSL por defecto

# ==============================================
# SQL SERVER 2008 LOCAL (GELITE SYNC)
# ==============================================
# 💾 Para sincronización con sistema dental legacy
# 🔐 Autenticación de Windows (usuario: GABINETE2\BOX2)
# ✅ Permisos ya configurados en SQL Server Management Studio
SQL_SERVER=GABINETE2\INFOMED
SQL_DATABASE=GELITE
# NO SE NECESITAN: SQL_USERNAME y SQL_PASSWORD para Windows Auth

# Configuración de JWT
JWT_SECRET=tu_jwt_secret_muy_largo_y_seguro_aqui
JWT_EXPIRES_IN=24h

# Configuración de la aplicación
NODE_ENV=development
PORT=3000

# Configuración de WhatsApp
WHATSAPP_TOKEN=tu_whatsapp_token
WHATSAPP_PHONE_NUMBER=tu_numero_whatsapp

# Configuración de email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_password_email

# Configuración de Puppeteer (para PDFs)
PUPPETEER_EXECUTABLE_PATH=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log