# CONFIGURACIÓN SQL SERVER 2008 LOCAL
# DentalCare Pro - Sistema de Gestión Dental
# 
# IMPORTANTE: Cambia estos valores por tus credenciales reales
# NUNCA subas este archivo con credenciales reales a Git

# Configuración SQL Server Local
SQL_SERVER=GABINETE2\INFOMED
SQL_DATABASE=GELITE
SQL_USERNAME=sa
SQL_PASSWORD=TU_PASSWORD_AQUI

# Configuración PostgreSQL (Render.com)
DB_HOST=tu-host-render.postgres.database.com
DB_PORT=5432
DB_NAME=dentalcare_pro_db
DB_USER=dentalcare_pro_user
DB_PASSWORD=TU_PASSWORD_POSTGRES
DB_SSL=false

# Configuración de JWT
JWT_SECRET=tu_jwt_secret_muy_largo_y_seguro_aqui
JWT_EXPIRES_IN=24h

# Configuración de la aplicación
NODE_ENV=development
PORT=3000

# Configuración de WhatsApp
WHATSAPP_TOKEN=tu_whatsapp_token
WHATSAPP_PHONE_NUMBER=tu_numero_whatsapp

# Configuración de email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_password_email

# Configuración de Puppeteer (para PDFs)
PUPPETEER_EXECUTABLE_PATH=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log