{
  "name": "dentalcare-pro",
  "version": "1.0.0",
  "description": "Sistema completo de gestión dental con agenda, pacientes, facturas, WhatsApp y cumplimiento LOPD",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss frontend/css/main.css -o frontend/css/main.min.css",
    "build:js": "webpack --mode production",
    "test": "jest",
    "lint": "eslint frontend/js/",
    "format": "prettier --write frontend/",
    "deploy": "git push origin main"
  },
  "keywords": [
    "dental",
    "clinic",
    "management",
    "appointments",
    "invoicing",
    "whatsapp",
    "lopd",
    "consent",
    "medical"
  ],
  "author": {
    "name": "MiniMax Agent",
    "email": "info@rubiogarciadental.com"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "express-slow-down": "^1.6.0",
    "mssql": "^10.0.1",
    "nodemailer": "^6.9.5",
    "twilio": "^4.17.1",
    "puppeteer": "^21.4.1",
    "pdf-lib": "^1.17.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "winston": "^3.11.0",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "autoprefixer": "^10.4.16",
    "webpack": "^5.89.0",
